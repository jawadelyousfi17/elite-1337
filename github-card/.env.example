# Strongly recommended: GitHub allows 5,000 requests an hour with a token, 60 an hour without (shared by every visitor).
# A token with no scopes is enough (public data only).
GITHUB_TOKEN=
# The public address of this site, used in the README snippets (for example https://card.example.com). Optional: the page falls back to the address in the browser.
NEXT_PUBLIC_SITE_URL=
